@app.route('/api/closed-loop/rules')
def api_closed_loop_rules():
    """Get auto-generated rules"""
    if not CLOSED_LOOP_AVAILABLE or not closed_loop_nids:
        return jsonify({'error': 'Rule generator not available'}), 500

    return jsonify({'rules': closed_loop_nids.get_auto_rules()})

@app.route('/api/closed-loop/rules/<rule_id>', methods=['POST'])
def api_closed_loop_rule_action(rule_id):
    """Enable/disable/delete an auto-generated rule"""
    if not CLOSED_LOOP_AVAILABLE or not closed_loop_nids:
        return jsonify({'error': 'Rule generator not available'}), 500

    data = request.json
    action = data.get('action')
    rule_gen = closed_loop_nids.rule_generator

    if action == 'enable':
        rule_gen.enable_rule(rule_id)
        load_network_rules()
        return jsonify({'status': 'enabled'})
    elif action == 'disable':
        rule_gen.disable_rule(rule_id)
        load_network_rules()
        return jsonify({'status': 'disabled'})
    elif action == 'delete':
        rule_gen.delete_rule(rule_id)
        load_network_rules()
        return jsonify({'status': 'deleted'})

    return jsonify({'error': 'Unknown action'}), 400

@app.route('/api/closed-loop/config', methods=['GET', 'POST'])
def api_closed_loop_config():
    """Get or update closed-loop configuration"""
    if not CLOSED_LOOP_AVAILABLE or not closed_loop_nids:
        return jsonify({'error': 'Closed-loop not available'}), 500

    if request.method == 'GET':
        return jsonify({
            'auto_generate_rules': closed_loop_nids.auto_generate_rules,
            'detector_enabled': closed_loop_nids.detector.enabled,
            'threshold': closed_loop_nids.detector.detection_threshold
        })

    # POST - update config
    data = request.json

    if 'auto_generate_rules' in data:
        closed_loop_nids.auto_generate_rules = data['auto_generate_rules']

    if 'detector_enabled' in data:
        if data['detector_enabled']:
            closed_loop_nids.detector.enable()
        else:
            closed_loop_nids.detector.disable()

    if 'threshold' in data:
        closed_loop_nids.detector.detection_threshold = data['threshold']

    return jsonify({'status': 'updated'})

@app.route('/api/closed-loop/reset', methods=['POST'])
